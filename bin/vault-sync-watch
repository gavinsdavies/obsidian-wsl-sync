#!/usr/bin/env bash
# vault-sync-watch — continuous low-latency sync for an Obsidian vault kept in
# two copies (Linux/WSL and Windows/NTFS).
#
# Linux -> Windows:  inotifywait reports the changed paths; after a short
#                    debounce it runs a scoped `unison <profile> -batch -path
#                    <each>`, syncing only those files (~1-3s) instead of the
#                    full-tree scan (tens of seconds over the 9p bridge).
# Windows -> Linux:  a full `unison <profile>` runs whenever the watcher has
#                    been idle for POLL seconds — inotify can't see writes that
#                    arrive on /mnt/c over 9p.
#
# Runs raw `unison`, never the vault-sync wrapper (which would append to its
# audit log on every call). Pair this with the hourly vault-sync.timer for
# frontmatter-conflict resolution and the audit line.
#
# Serialised with the wrapper via `flock -E 99` on VAULT_SYNC_LOCK so two
# `unison` processes never touch the same archive.
#
# Config: sourced from $VAULT_SYNC_ENV or ~/.config/vault-sync/vault-sync.env
#   LOCAL_VAULT             Linux/WSL vault root (required)
#   UNISON_PROFILE          profile name (default: vault)
#   VAULT_SYNC_LOCK         lock path (default: ~/.unison/vault-sync.lock)
#   VAULT_SYNC_STATUS_FILE  status-callout file for an Obsidian embed (default: off)
#   VAULT_SYNC_POLL         seconds; Windows->Linux cadence (default: 15)
#   VAULT_SYNC_DEBOUNCE     seconds of quiet after a change before syncing (default: 2)
#   VAULT_SYNC_MAXPATHS     burst size above which it full-syncs (default: 25)
set -u

CONFIG="${VAULT_SYNC_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/vault-sync/vault-sync.env}"
if [ -f "$CONFIG" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONFIG"
    set +a
fi

: "${LOCAL_VAULT:?set LOCAL_VAULT (see examples/vault-sync.env.example)}"
LOCAL="${LOCAL_VAULT%/}"
PROFILE="${UNISON_PROFILE:-vault}"
LOCK="${VAULT_SYNC_LOCK:-$HOME/.unison/vault-sync.lock}"
POLL="${VAULT_SYNC_POLL:-15}"
DEBOUNCE="${VAULT_SYNC_DEBOUNCE:-2}"
MAXPATHS="${VAULT_SYNC_MAXPATHS:-25}"
STATUS="${VAULT_SYNC_STATUS_FILE:-}"
STATUS_HEARTBEAT=60           # re-stamp a steady "synced" badge at most this often

command -v inotifywait >/dev/null || { echo "inotifywait not found — install inotify-tools" >&2; exit 1; }
command -v unison      >/dev/null || { echo "unison not found" >&2; exit 1; }
mkdir -p "$(dirname "$LOCK")"

# Editor/OS scratch noise, plus the status/history files if they live in the tree.
EXCLUDE='(/\.obsidian/workspace(-mobile)?\.json$|/\.obsidian/cache/|/4913$|/~\$|\.sw[px]$|\.tmp$|\.goutputstream|/\.unison)'
_add_exclude() {   # $1 = absolute path; add its basename to EXCLUDE
    [ -n "$1" ] || return 0
    local base; base=$(printf '%s' "${1##*/}" | sed 's/[][\.*^$/]/\\&/g')
    EXCLUDE="${EXCLUDE%)}|/${base}\$)"
}
_add_exclude "$STATUS"
_add_exclude "${VAULT_SYNC_HISTORY_FILE:-}"

last_status_level=""
last_status_write=0

write_status() {   # $1=level (success|warning|failure)   $2=message
    [ -n "$STATUS" ] || return 0
    local now; now=$(date +%s)
    if [ "$1" = success ] && [ "$1" = "$last_status_level" ] \
       && [ $(( now - last_status_write )) -lt "$STATUS_HEARTBEAT" ]; then
        return
    fi
    {
        printf '> [!%s] %s\n' "$1" "$2"
        printf '> `%s` · Linux <-> Windows sync\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    } > "$STATUS" 2>/dev/null || true
    last_status_level="$1"; last_status_write="$now"
}

status_from_rc() {   # $1 = unison/flock exit code
    case "$1" in
        0)  write_status success "Vault synced" ;;
        1)  write_status warning "Differences need review — run vault-sync" ;;
        99) : ;;   # flock -w timeout: transient contention with the hourly sweep
        *)  write_status failure "Sync error (unison exit $1) — check vault-sync-watch" ;;
    esac
}

full_sync() {
    flock -w "$POLL" -E 99 "$LOCK" unison "$PROFILE" -batch -silent -dumbtty
    status_from_rc $?
}
scoped_sync() {   # args: vault-root-relative paths
    local args=() p
    for p in "$@"; do
        [ -n "$p" ] || continue
        case "$p" in /*) continue ;; esac        # prefix-strip failed -> let the poll catch it
        args+=(-path "$p")
    done
    [ ${#args[@]} -eq 0 ] && return 0
    flock -w "$((POLL * 3))" -E 99 "$LOCK" unison "$PROFILE" -batch -silent -dumbtty "${args[@]}"
    status_from_rc $?
}

FIFO="$(mktemp -u "${TMPDIR:-/tmp}/vault-sync-watch.XXXXXX")"
mkfifo "$FIFO"
cleanup() { [ -n "${IW:-}" ] && kill "$IW" 2>/dev/null; rm -f "$FIFO"; }
trap cleanup EXIT

# Start the watcher first so nothing is missed during the initial full sync;
# events buffer in the pipe until we start reading.
inotifywait -m -r -q \
    -e close_write -e create -e delete -e move \
    --exclude "$EXCLUDE" \
    @"$LOCAL/.git" \
    @"$LOCAL/.obsidian/plugins" \
    @"$LOCAL/.obsidian/icons" \
    @"$LOCAL/.obsidian/themes" \
    @"$LOCAL/.trash" \
    --format '%w%f' "$LOCAL" > "$FIFO" 2>/dev/null &
IW=$!
exec 3<"$FIFO"

echo "vault-sync-watch: inotify+scoped on $LOCAL (debounce ${DEBOUNCE}s, full poll ${POLL}s, watcher pid $IW)"
write_status warning "Sync starting…"
full_sync
last_full=$(date +%s)

while kill -0 "$IW" 2>/dev/null; do
    if IFS= read -r -u 3 -t "$POLL" line; then
        paths=("${line#"$LOCAL"/}")
        while IFS= read -r -u 3 -t "$DEBOUNCE" line; do
            paths+=("${line#"$LOCAL"/}")
        done
        now=$(date +%s)
        if [ $(( now - last_full )) -ge "$POLL" ] || [ ${#paths[@]} -gt "$MAXPATHS" ]; then
            full_sync; last_full=$now
        else
            mapfile -t uniq < <(printf '%s\n' "${paths[@]}" | sort -u)
            scoped_sync "${uniq[@]}"
        fi
    else
        rc=$?
        [ "$rc" -le 128 ] && { echo "read from watcher failed (rc=$rc)" >&2; break; }
        full_sync; last_full=$(date +%s)          # POLL timeout -> Windows->Linux sweep
    fi
done

write_status failure "Watcher stopped — a supervisor should restart it"
echo "inotifywait ($IW) gone — exiting" >&2
exit 1
