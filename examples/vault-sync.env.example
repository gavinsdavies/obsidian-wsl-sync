# obsidian-wsl-sync configuration.
#
# Copy to ~/.config/vault-sync/vault-sync.env and edit. This is shell syntax,
# sourced by both bin/vault-sync and bin/vault-sync-watch.

# --- required -------------------------------------------------------------

# The Linux/WSL copy of the vault. Keep this one on a native filesystem
# (ext4), not under /mnt/c — that is the whole point of the two-copy setup.
LOCAL_VAULT="$HOME/vaults/MyVault"

# The Windows copy — the folder the Windows Obsidian app opens.
WINDOWS_VAULT="/mnt/c/Users/YOU/Documents/MyVault"

# Unison profile name. Must match ~/.unison/<name>.prf
UNISON_PROFILE="vault"

# --- optional ----------------------------------------------------------

# Python for the wrapper. Leave unset to use `uv run` (if uv is installed) or
# plain python3 (PyYAML must then be importable). install.sh sets this only
# when it falls back to building a venv.
#VAULT_SYNC_PYTHON="$HOME/.local/share/vault-sync/venv/bin/python"

# Unison profile file, if it is not at ~/.unison/<UNISON_PROFILE>.prf
#UNISON_PRF="$HOME/.unison/vault.prf"

# Extra paths the watch daemon should not watch, space-separated, relative to
# LOCAL_VAULT. The daemon already skips whatever the profile's `ignore = Path`
# lines list; this is for anything else.
#VAULT_SYNC_NOWATCH=".obsidian/plugins .some/big/dir"

# A status-callout file for embedding in an Obsidian note (a green check when
# synced, amber/red otherwise). Unset = the daemon writes no status file.
#VAULT_SYNC_STATUS_FILE="$LOCAL_VAULT/.sync-status.md"

# One audit line per hourly sweep. Unset = no log.
#VAULT_SYNC_HISTORY_FILE="$LOCAL_VAULT/.vault-sync-history.md"

# Lock shared by the watch daemon and the hourly sweep so `unison` never runs twice.
#VAULT_SYNC_LOCK="$HOME/.unison/vault-sync.lock"

# Watch daemon tuning.
#VAULT_SYNC_POLL=15        # seconds between full syncs (the Windows->Linux path)
#VAULT_SYNC_DEBOUNCE=2     # seconds of quiet after a Linux write before syncing
#VAULT_SYNC_MAXPATHS=25    # a burst larger than this triggers a full sync instead

# Wrapper: seconds to wait for Obsidian to re-stamp `updated:` during auto-resolve.
#SLEEP_SECONDS=3
